{
  "name": "Employee Request Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "employee-request",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "1f1b1a10-0001-4a10-9a10-000000000001",
      "name": "Webhook - Employee Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "chat",
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an enterprise request triage assistant. Classify the employee request into one of: HR, Finance, IT, Procurement. Extract a short summary, a priority (Low, Medium, High), and a one-line suggested response. Respond ONLY in strict JSON with keys: category, summary, priority, suggested_response."
            },
            {
              "role": "user",
              "content": "={{ $json.body.message }}"
            }
          ]
        },
        "options": {
          "temperature": 0.2
        }
      },
      "id": "1f1b1a10-0002-4a10-9a10-000000000002",
      "name": "OpenAI - Classify Request",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const aiResponse = JSON.parse($input.first().json.message.content);\nreturn [{ json: { ...aiResponse, employee: $('Webhook - Employee Request').first().json.body.employee, original_message: $('Webhook - Employee Request').first().json.body.message, timestamp: new Date().toISOString() } }];"
      },
      "id": "1f1b1a10-0003-4a10-9a10-000000000003",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.category }}",
        "rules": {
          "rules": [
            { "value2": "IT", "output": 0 },
            { "value2": "HR", "output": 1 },
            { "value2": "Finance", "output": 2 },
            { "value2": "Procurement", "output": 3 }
          ]
        },
        "fallbackOutput": 4
      },
      "id": "1f1b1a10-0004-4a10-9a10-000000000004",
      "name": "Route by Department",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "resource": "issue",
        "operation": "create",
        "project": "={{ $json.itProjectKey }}",
        "summary": "={{ $json.summary }}",
        "additionalFields": {
          "description": "={{ $json.original_message }}",
          "priority": "={{ $json.priority }}"
        }
      },
      "id": "1f1b1a10-0005-4a10-9a10-000000000005",
      "name": "Create Jira Ticket (IT)",
      "type": "n8n-nodes-base.jira",
      "typeVersion": 1,
      "position": [1140, 140]
    },
    {
      "parameters": {
        "sendTo": "hr-team@company.com",
        "subject": "=New HR Request: {{ $json.summary }}",
        "message": "=Employee: {{ $json.employee }}\\nPriority: {{ $json.priority }}\\nDetails: {{ $json.original_message }}"
      },
      "id": "1f1b1a10-0006-4a10-9a10-000000000006",
      "name": "Email HR Team",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1140, 280]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "sheetId": "={{ $json.financeSheetId }}",
        "range": "Requests!A:E",
        "options": {}
      },
      "id": "1f1b1a10-0007-4a10-9a10-000000000007",
      "name": "Log to Finance Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [1140, 420]
    },
    {
      "parameters": {
        "sendTo": "procurement@company.com",
        "subject": "=New Procurement Request: {{ $json.summary }}",
        "message": "=Employee: {{ $json.employee }}\\nPriority: {{ $json.priority }}\\nDetails: {{ $json.original_message }}"
      },
      "id": "1f1b1a10-0008-4a10-9a10-000000000008",
      "name": "Email Procurement",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [1140, 560]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.priority }}",
              "value2": "High"
            }
          ]
        }
      },
      "id": "1f1b1a10-0009-4a10-9a10-000000000009",
      "name": "Is High Priority?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1380, 300]
    },
    {
      "parameters": {
        "channel": "#manager-approvals",
        "text": "=High priority request from {{ $json.employee }}: {{ $json.summary }}. Approve?"
      },
      "id": "1f1b1a10-0010-4a10-9a10-000000000010",
      "name": "Slack - Manager Approval Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1600, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": "={{ $json.auditLogSheetId }}",
        "range": "AuditLog!A:F",
        "options": {}
      },
      "id": "1f1b1a10-0011-4a10-9a10-000000000011",
      "name": "Write Audit Log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [1600, 400]
    }
  ],
  "connections": {
    "Webhook - Employee Request": {
      "main": [[{ "node": "OpenAI - Classify Request", "type": "main", "index": 0 }]]
    },
    "OpenAI - Classify Request": {
      "main": [[{ "node": "Parse AI Output", "type": "main", "index": 0 }]]
    },
    "Parse AI Output": {
      "main": [[{ "node": "Route by Department", "type": "main", "index": 0 }]]
    },
    "Route by Department": {
      "main": [
        [{ "node": "Create Jira Ticket (IT)", "type": "main", "index": 0 }],
        [{ "node": "Email HR Team", "type": "main", "index": 0 }],
        [{ "node": "Log to Finance Sheet", "type": "main", "index": 0 }],
        [{ "node": "Email Procurement", "type": "main", "index": 0 }]
      ]
    },
    "Create Jira Ticket (IT)": {
      "main": [[{ "node": "Is High Priority?", "type": "main", "index": 0 }]]
    },
    "Email HR Team": {
      "main": [[{ "node": "Is High Priority?", "type": "main", "index": 0 }]]
    },
    "Log to Finance Sheet": {
      "main": [[{ "node": "Is High Priority?", "type": "main", "index": 0 }]]
    },
    "Email Procurement": {
      "main": [[{ "node": "Is High Priority?", "type": "main", "index": 0 }]]
    },
    "Is High Priority?": {
      "main": [
        [{ "node": "Slack - Manager Approval Alert", "type": "main", "index": 0 }],
        [{ "node": "Write Audit Log", "type": "main", "index": 0 }]
      ]
    },
    "Slack - Manager Approval Alert": {
      "main": [[{ "node": "Write Audit Log", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1"
}
